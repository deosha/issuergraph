# IssuerGraph configuration. Copy to .env and edit; never commit the copy.
# Every value here is optional — the site runs with none of them set, which is
# why there are no secrets in this file and no placeholders that look real.

# --- database -----------------------------------------------------------------
# The pipeline and /app need this. The landing page and /demo do not.
ISSUERGRAPH_DSN=postgresql:///issuergraph

# --- deployment shape ---------------------------------------------------------
# 1 = serve the marketing site and the snapshot-backed demo only, and 404 /app.
# A public host has no reason to expose the live database API.
ISSUERGRAPH_DEMO_ONLY=0

# --- who to contact -----------------------------------------------------------
ISSUERGRAPH_PRODUCT_NAME=IssuerGraph
ISSUERGRAPH_CONTACT_EMAIL=hello@issuergraph.com
ISSUERGRAPH_FOUNDER_NAME=
ISSUERGRAPH_FOUNDER_ROLE=Founder
ISSUERGRAPH_FOUNDER_BIO=
# Optional. With no URL set, no LinkedIn link is rendered.
ISSUERGRAPH_FOUNDER_LINKEDIN=
# Optional. With no URL set, the "Book a call" button is not rendered at all.
ISSUERGRAPH_BOOKING_URL=

# --- pilot commercials --------------------------------------------------------
# Leave the price empty to ask for scope instead of quoting a number, which is
# the honest default until a pilot has been scoped. Setting it replaces the
# "pricing is scoped per pilot" paragraph with the figure.
ISSUERGRAPH_PILOT_PRICE=
ISSUERGRAPH_PILOT_LENGTH=four weeks

# --- pilot form throttling ----------------------------------------------------
ISSUERGRAPH_PILOT_RATE_MAX=5
ISSUERGRAPH_PILOT_RATE_WINDOW=3600
# Proxies you control in front of the process (App Runner, one load balancer: 1).
# The rate limiter takes the caller's address that many hops from the right of
# X-Forwarded-For and ignores the rest. 0 = use the peer address.
ISSUERGRAPH_TRUSTED_PROXY_HOPS=0
# Salt for the rate-limiter's client hash. Set any random string in production;
# the hash is never reversible into an address and is never stored as one.
ISSUERGRAPH_RATE_SALT=

# --- analytics (optional) -----------------------------------------------------
# With no key, no analytics script is loaded and no third-party request is made.
# Events carry counts and page numbers only — never names, addresses, form text
# or document content; see the allowlist in static/analytics.js.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- CRM forwarding (optional, server-side) -----------------------------------
# A pilot request is stored first; forwarding failures never fail the visitor's
# submission. No outreach or marketing sequence is triggered from here.
ISSUERGRAPH_CRM_WEBHOOK_URL=
ISSUERGRAPH_CRM_WEBHOOK_TOKEN=
