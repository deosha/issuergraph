# Production configuration for the public site.
#
# Copy to .env.production, fill the two blanks, and load it into your platform's
# secret store — App Runner secrets, Lightsail environment file, whatever you
# use. Do not commit the filled copy: ISSUERGRAPH_DSN contains a password and
# ISSUERGRAPH_RATE_SALT is what stops stored hashes being reversed into IP
# addresses.

# --- deployment shape ---------------------------------------------------------
# Serve the landing page, demo and pilot form; 404 the live workspace. The public
# site needs no pipeline, no PDFs and no document database.
ISSUERGRAPH_DEMO_ONLY=1

# --- secrets: fill these in ---------------------------------------------------
# From the database you create. RDS gives you the endpoint; on a single box this
# is 127.0.0.1. Only sql/006_pilot_requests.sql needs to be applied to it.
ISSUERGRAPH_DSN=

# openssl rand -hex 32
ISSUERGRAPH_RATE_SALT=

# --- identity -----------------------------------------------------------------
ISSUERGRAPH_PRODUCT_NAME=IssuerGraph
ISSUERGRAPH_CONTACT_EMAIL=deo@issuergraph.com
ISSUERGRAPH_FOUNDER_NAME=Deo Shankar
ISSUERGRAPH_FOUNDER_ROLE=Founder
# One line: this file is sourced by a shell, so a value cannot span lines.
ISSUERGRAPH_FOUNDER_BIO=Deo Shankar is the founder of IssuerGraph. He brings over 14 years of experience in cloud architecture and enterprise engineering, including work across banking and financial services. He is building IssuerGraph to help credit-research teams review issuer debt and rating changes, compare information across documents, and trace findings back to their original sources.
# Optional. With no URL set, no LinkedIn link is rendered.
ISSUERGRAPH_FOUNDER_LINKEDIN=
ISSUERGRAPH_BOOKING_URL=https://cal.com/deo-shankar-yjzpnf/issuergraph-pilot

# --- pilot commercials --------------------------------------------------------
# Empty asks for scope rather than quoting a number. Set it only once a pilot
# has a price you will stand behind.
ISSUERGRAPH_PILOT_PRICE=
ISSUERGRAPH_PILOT_LENGTH=four weeks

# --- throttling ---------------------------------------------------------------
ISSUERGRAPH_PILOT_RATE_MAX=5
ISSUERGRAPH_PILOT_RATE_WINDOW=3600
# Proxies you control in front of the process (App Runner, one load balancer: 1).
# The rate limiter takes the caller's address that many hops from the right of
# X-Forwarded-For and ignores the rest. 0 = use the peer address.
ISSUERGRAPH_TRUSTED_PROXY_HOPS=1

# --- optional -----------------------------------------------------------------
# No key: no analytics script is loaded and no third-party request is made.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ISSUERGRAPH_CRM_WEBHOOK_URL=
ISSUERGRAPH_CRM_WEBHOOK_TOKEN=
